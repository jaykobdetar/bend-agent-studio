import Base

# This source was generated from an original fixed-order schoolbook generator.
# 8 digits in base 2^11; only 44/56 fractional bits; positive range below 2^30.
type FixedProduct is Data:
  FixedWindow{lower: List<&2, U32>, upper: List<&2, U32>, sticky: U32}

def limb_wide_add(a: U32, b: U32) -> U32:
  F32.to_u32(F32.add(U32.to_f32(a), U32.to_f32(b)))

def limb_wide_mul(a: U32, b: U32) -> U32:
  F32.to_u32(F32.mul(U32.to_f32(a), U32.to_f32(b)))

def finish_window(lo: List<&2, U32>, hi: List<&2, U32>, sticky: U32, ok: Bool) -> Maybe<&2, FixedProduct>:
  match ok:
    case True{}:
      Some{FixedWindow{lo, hi, sticky}}
    case False{}:
      None{}

def fits_value(d6: U32, d7: U32, short_mode: Bool) -> Bool:
  match short_mode:
    case True{}:
      Bool.and(U32.is_eq(d7, 0), U32.is_lt(d6, 256))
    case False{}:
      U32.is_lt(d7, 512)

def rounded_window(+q0: U32, +q1: U32, +q2: U32, +q3: U32, +q4: U32, +q5: U32, +q6: U32, +q7: U32, high: U32, +sticky: U32, short_mode: Bool) -> Maybe<&2, FixedProduct>:
  +n0 = limb_wide_add(q0, sticky)
  +u0 = U32.and(n0, 2047)
  uc0 = U32.shrn(n0, 11n)
  +n1 = limb_wide_add(q1, uc0)
  +u1 = U32.and(n1, 2047)
  uc1 = U32.shrn(n1, 11n)
  +n2 = limb_wide_add(q2, uc1)
  +u2 = U32.and(n2, 2047)
  uc2 = U32.shrn(n2, 11n)
  +n3 = limb_wide_add(q3, uc2)
  +u3 = U32.and(n3, 2047)
  uc3 = U32.shrn(n3, 11n)
  +n4 = limb_wide_add(q4, uc3)
  +u4 = U32.and(n4, 2047)
  uc4 = U32.shrn(n4, 11n)
  +n5 = limb_wide_add(q5, uc4)
  +u5 = U32.and(n5, 2047)
  uc5 = U32.shrn(n5, 11n)
  +n6 = limb_wide_add(q6, uc5)
  +u6 = U32.and(n6, 2047)
  uc6 = U32.shrn(n6, 11n)
  +n7 = limb_wide_add(q7, uc6)
  +u7 = U32.and(n7, 2047)
  uc7 = U32.shrn(n7, 11n)
  ok = Bool.and(U32.is_eq(U32.or(high, uc7), 0), fits_value(u6, u7, short_mode))
  finish_window([q0, q1, q2, q3, q4, q5, q6, q7], [u0, u1, u2, u3, u4, u5, u6, u7], sticky, ok)

def shift_44(+z0: U32, +z1: U32, +z2: U32, +z3: U32, +z4: U32, +z5: U32, +z6: U32, +z7: U32, +z8: U32, +z9: U32, +z10: U32, +z11: U32, +z12: U32, +z13: U32, +z14: U32, +z15: U32) -> Maybe<&2, FixedProduct>:
  q0 = z4
  q1 = z5
  q2 = z6
  q3 = z7
  q4 = z8
  q5 = z9
  q6 = z10
  q7 = z11
  sticky = Bool.to_u32(U32.is_gt(U32.or(U32.or(z0, z1), U32.or(z2, z3)), 0))
  rounded_window(q0, q1, q2, q3, q4, q5, q6, q7, U32.or(U32.or(z12, z13), U32.or(z14, z15)), sticky, True{})

def shift_56(+z0: U32, +z1: U32, +z2: U32, +z3: U32, +z4: U32, +z5: U32, +z6: U32, +z7: U32, +z8: U32, +z9: U32, +z10: U32, +z11: U32, +z12: U32, +z13: U32, +z14: U32, +z15: U32) -> Maybe<&2, FixedProduct>:
  q0 = U32.or(U32.shrn(z5, 1n), U32.shln(U32.and(z6, 1), 10n))
  q1 = U32.or(U32.shrn(z6, 1n), U32.shln(U32.and(z7, 1), 10n))
  q2 = U32.or(U32.shrn(z7, 1n), U32.shln(U32.and(z8, 1), 10n))
  q3 = U32.or(U32.shrn(z8, 1n), U32.shln(U32.and(z9, 1), 10n))
  q4 = U32.or(U32.shrn(z9, 1n), U32.shln(U32.and(z10, 1), 10n))
  q5 = U32.or(U32.shrn(z10, 1n), U32.shln(U32.and(z11, 1), 10n))
  q6 = U32.or(U32.shrn(z11, 1n), U32.shln(U32.and(z12, 1), 10n))
  q7 = U32.or(U32.shrn(z12, 1n), U32.shln(U32.and(z13, 1), 10n))
  sticky = Bool.to_u32(U32.is_gt(U32.or(U32.or(z0, U32.or(z1, z2)), U32.or(z3, U32.or(z4, U32.and(z5, 1)))), 0))
  rounded_window(q0, q1, q2, q3, q4, q5, q6, q7, U32.or(U32.shrn(z13, 1n), U32.or(z14, z15)), sticky, False{})

def rescale_window(z0: U32, z1: U32, z2: U32, z3: U32, z4: U32, z5: U32, z6: U32, z7: U32, z8: U32, z9: U32, z10: U32, z11: U32, z12: U32, z13: U32, z14: U32, z15: U32, short_mode: Bool) -> Maybe<&2, FixedProduct>:
  match short_mode:
    case True{}:
      shift_44(z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11, z12, z13, z14, z15)
    case False{}:
      shift_56(z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11, z12, z13, z14, z15)

