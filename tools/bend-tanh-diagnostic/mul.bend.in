def checked_product(a0: U32, a1: U32, a2: U32, a3: U32, a4: U32, a5: U32, a6: U32, a7: U32, b0: U32, b1: U32, b2: U32, b3: U32, b4: U32, b5: U32, b6: U32, b7: U32, short_mode: Bool, ok: Bool) -> Maybe<&2, FixedProduct>:
  match ok:
    case True{}:
      normalized_product(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7, short_mode)
    case False{}:
      None{}

def wide_fixed_mul(+frac: U32, +a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32, +b0: U32, +b1: U32, +b2: U32, +b3: U32, +b4: U32, +b5: U32, +b6: U32, +b7: U32) -> Maybe<&2, FixedProduct>:
  +short_mode = U32.is_eq(frac, 44)
  allowed = Bool.or(short_mode, U32.is_eq(frac, 56))
  digits_valid = U32.is_lt(U32.or(U32.or(U32.or(U32.or(a0, a1), U32.or(a2, a3)), U32.or(U32.or(a4, a5), U32.or(a6, a7))), U32.or(U32.or(U32.or(b0, b1), U32.or(b2, b3)), U32.or(U32.or(b4, b5), U32.or(b6, b7)))), 2048)
  within = fits_value(U32.or(a6, b6), U32.or(a7, b7), short_mode)
  ok = Bool.and(allowed, Bool.and(digits_valid, within))
  checked_product(a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7, short_mode, ok)
